{
  "tasks": {
    "dev": "deno run -A node_modules/.bin/react-router dev",
    "build": "deno run -A node_modules/.bin/react-router build",
    "start": "deno run -A --sloppy-imports server/index.ts",
    "preview": "deno task build && deno task start",
    "typecheck": "deno run -A node_modules/.bin/react-router typegen && deno run -A node_modules/.bin/tsc -b",
    "lint": "deno run -A node_modules/.bin/eslint .",
    "test": "deno run -A node_modules/.bin/vitest run --coverage",
    "test:watch": "deno run -A node_modules/.bin/vitest"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite@^0.12.0"
  },
  "nodeModulesDir": "manual",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
